# =============================================
# 新聞輿情風向儀 — 環境變數範本
# 複製此檔案為 .env.local 並填入實際值
# =============================================

# AI 分析 API Key（banana2556 平台）
# 用於：情緒分析 (gpt-5.4-mini)、輿情總結 (gpt-5.4)、關鍵詞萃取
# 取得：登入 https://api.banana2556.com 後建立 API Key
CPA_API_KEY=

# NewsAPI.org API Key
# 用於：補充台灣新聞來源（免費方案每天 100 次請求）
# 取得：https://newsapi.org/register
NEWS_API_KEY=

# 網站標題（顯示於頁首，可自訂）
NEXT_PUBLIC_SITE_TITLE=新聞輿情風向儀

# Upstash Redis 快取（取代舊的 Vercel KV）
# 本地開發若未設定，系統自動 fallback 至記憶體快取（重啟後失效）
# 設定方式：Vercel Dashboard → Integrations → Upstash Redis → Add → Connect to Project
# 或：upstash.com 建立免費 Database 後手動填入
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
